<?php
/**
 * Skopiuj ten plik jako "config.local.php" (w tym samym folderze) i uzupełnij
 * prawdziwymi danymi. Plik "config.local.php" NIE jest w repozytorium git
 * (patrz .gitignore) — Twoje hasła nigdy nie trafią do kodu źródłowego.
 *
 * Na home.pl: dane do bazy MySQL znajdziesz w Panelu klienta → Bazy danych.
 * Dane SMTP: Panel klienta → Poczta (jeśli korzystasz ze skrzynki na domenie)
 * albo z zewnętrznej usługi pocztowej.
 */

// --- Baza danych ---
// Na home.pl zawsze "mysql". Zostaw "sqlite" tylko do szybkiego testowania
// na własnym komputerze bez zakładania bazy MySQL (patrz README_PHP.md).
define('DB_DRIVER', 'mysql'); // "mysql" albo "sqlite"

define('DB_HOST', 'localhost');
define('DB_PORT', 3306);
define('DB_NAME', 'nazwa_twojej_bazy');
define('DB_USER', 'uzytkownik_bazy');
define('DB_PASS', 'haslo_do_bazy');

// Plik bazy SQLite (używany tylko, gdy DB_DRIVER = "sqlite"):
define('SQLITE_PATH', __DIR__ . '/data.sqlite');

// --- Adres strony (bez ukośnika na końcu) — używany w linkach w e-mailach ---
define('APP_URL', 'https://twojadomena.pl');

// --- Bezpieczeństwo sesji ---
// Dowolny długi, losowy ciąg znaków — zmień na własny!
define('AUTH_SECRET', 'ZMIEN-MNIE-NA-DLUGI-LOSOWY-CIAG-ZNAKOW-1234567890');

// --- Poczta SMTP (jeśli puste, e-maile tylko zapisują się do logu
//     w php/storage/mail.log zamiast być wysyłane — wygodne do testów) ---
define('SMTP_HOST', ''); // np. "smtp.home.pl"
define('SMTP_PORT', 587);
define('SMTP_USER', '');
define('SMTP_PASS', '');
define('SMTP_FROM_EMAIL', 'kontakt@twojadomena.pl');
define('SMTP_FROM_NAME', 'InnovaGo');

// --- SMS (opcjonalnie) ---
// InnovaGo ma gotowy punkt integracji z bramką SMS (np. SMSAPI.pl,
// SerwerSMS.pl) w includes/sms.php. Dopóki poniższe pola są puste, SMS-y
// tylko zapisują się do logu (php/storage/sms.log) zamiast być faktycznie
// wysyłane — działanie w kodzie jest już gotowe, brakuje tylko klucza API
// prawdziwego dostawcy (patrz komentarz w includes/sms.php).
define('SMS_API_TOKEN', '');
define('SMS_SENDER_NAME', 'InnovaGo');

// --- Konto super-admina (właściciela platformy InnovaGo) tworzone przez
//     install.php — to jest konto, którym Ty zarządzasz wszystkimi
//     organizacjami/klientami i ich planami subskrypcji. ---
define('SEED_SUPERADMIN_EMAIL', 'super@innovago.pl');
define('SEED_SUPERADMIN_PASSWORD', 'ZmienMnie123!');

// --- Dane demo-organizacji tworzonej przez install.php (do testów) ---
define('SEED_DEMO_ORG_ADMIN_EMAIL', 'admin@demo-szkola.pl');
define('SEED_DEMO_ORG_ADMIN_PASSWORD', 'Demo123!');
