# Zdjęcia w tym folderze mają być tylko odczytywane jako obrazy — nigdy
# wykonywane jako PHP (na wypadek, gdyby ktoś podrzucił plik z fałszywym
# rozszerzeniem obrazka).
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php\d)$">
  Require all denied
</FilesMatch>
