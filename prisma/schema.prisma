// Prisma schema for the Innova kids' creative studio registration system.
// Default datasource is SQLite for a zero-config local/dev setup.
// For production, switch `provider` to "mysql" (see DEPLOY.md for home.pl /
// shared-hosting deployment) or "postgresql" — the rest of the schema works
// unchanged.

generator client {
  provider = "prisma-client-js"
  // Covers common shared-hosting Linux distros (the exact one on home.pl's
  // Node.js hosting isn't publicly documented) in addition to whatever OS
  // you develop on. Harmless to keep even if unused.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  INSTRUCTOR
  ADMIN
}

enum EnrollmentStatus {
  PENDING // just submitted by a parent — awaiting staff review & group assignment
  CONFIRMED
  WAITLIST
  CANCELED
}

enum SessionStatus {
  SCHEDULED
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(PARENT)
  createdAt    DateTime @default(now())

  children         Child[]
  enrollments      Enrollment[]
  sessionsAsCoach  ClassSession[] @relation("InstructorSessions")
}

model ClassType {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. ROBOTICS, CREATIVE, THEATER, ENGLISH
  name        String
  description String
  color       String   @default("#6366f1")
  ageMin      Int      @default(5)
  ageMax      Int      @default(12)
  createdAt   DateTime @default(now())

  sessions     ClassSession[]
  pricingTiers PricingTier[]
}

/// Marketing/pricing info shown on the public offer page (cennik) — one row
/// per age group / variant of a class type, e.g. "Mix kreatywny, 5–7 lat,
/// 50 min, 229 zł/mies.". Purely informational: independent of the bookable
/// ClassSession schedule below (this app doesn't handle payments).
model PricingTier {
  id           String    @id @default(cuid())
  classTypeId  String
  classType    ClassType @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
  label        String // e.g. "Mix kreatywny" — blank-friendly, falls back to the class name in the UI
  ageLabel     String // e.g. "5–7 lat"
  durationMin  Int
  priceMonthly Int // w złotych / miesiąc
  oneTimeFee   Int? // np. pakiet startowy do szydełkowania
  sortOrder    Int       @default(0)

  @@index([classTypeId])
}

model Child {
  id        String   @id @default(cuid())
  parentId  String
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  birthDate DateTime
  notes     String?
  createdAt DateTime @default(now())

  enrollments Enrollment[]
}

model ClassSession {
  id             String        @id @default(cuid())
  classTypeId    String
  classType      ClassType     @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
  title          String
  description    String? // optional override / extra info for this specific date
  startsAt       DateTime
  endsAt         DateTime
  capacity       Int           @default(10) // studio rule: max 10 dzieci na grupę
  meetingUrl     String? // online meeting link, shown to confirmed parents
  instructorId   String?
  instructor     User?         @relation("InstructorSessions", fields: [instructorId], references: [id])
  instructorName String // free-text fallback so an instructor account isn't mandatory
  status         SessionStatus @default(SCHEDULED)
  createdAt      DateTime      @default(now())

  enrollments Enrollment[]

  @@index([startsAt])
  @@index([classTypeId])
}

model Enrollment {
  id          String           @id @default(cuid())
  sessionId   String
  session     ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  childId     String
  child       Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  parentId    String
  parent      User             @relation(fields: [parentId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  confirmedAt DateTime?
  canceledAt  DateTime?

  @@unique([sessionId, childId])
  @@index([parentId])
}
