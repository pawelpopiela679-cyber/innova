# --- Database ---
# SQLite works out of the box for local dev / a small studio.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Random long string used to sign session JWTs. Generate e.g. with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Outgoing email (used for registration confirmations and the
# "new sign-up" alert to the studio) ---
# If these are left empty, emails are simply logged to the server console
# instead of being sent — handy for local development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Pracownia Innova <no-reply@innova-pracownia.pl>"

# Address(es) that receive a notification every time a child is signed up
# for a class. Comma-separate for multiple recipients.
STUDIO_NOTIFY_EMAIL="kontakt@innova-pracownia.pl"

# --- Seed data ---
# Admin (studio owner) account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@innova-pracownia.pl"
SEED_ADMIN_PASSWORD="ZmienMnie123!"
